# ==============================================================================
# SERVER-ONLY SECRETS (NEVER EXPOSE TO THE BROWSER - DO NOT PREFIX WITH VITE_)
# ==============================================================================
# Telnyx API v2 Key (from portal.telnyx.com -> API Keys)
# Used exclusively by the Express backend (server.ts) to authenticate with Telnyx
TELNYX_API_KEY="KEY018..._YOUR_SERVER_ONLY_TELNYX_API_KEY"

# Telnyx Public Key for Ed25519 Webhook Signature Verification
# (from portal.telnyx.com -> Keys & Credentials -> Public Key)
TELNYX_PUBLIC_KEY="YOUR_TELNYX_ED25519_PUBLIC_KEY"

# Assigned Telnyx Outbound Caller ID (must be an active number on your Telnyx account)
TELNYX_CALLER_ID="+1XXXXXXXXXX"

# Optional: Pre-provisioned Telnyx WebRTC Telephony Credential ID
# If not specified, the backend creates an on-demand credential automatically
TELNYX_CREDENTIAL_ID=""

# Optional: Telnyx SIP Connection ID
TELNYX_SIP_CONNECTION_ID=""

# ==============================================================================
# CLIENT-SAFE CONFIGURATION (Optional - non-secret parameters only)
# ==============================================================================
# Outbound Caller ID display number (safe public number)
VITE_TELNYX_CALLER_ID="+1XXXXXXXXXX"

# Telnyx SIP Connection ID (public identifier, not a secret)
VITE_TELNYX_SIP_CONNECTION_ID=""

# Supabase Database Configuration (Optional - app defaults to local persistence)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server runtime port
PORT=3000
